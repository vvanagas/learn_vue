# Dependencies — reinstallable from lockfiles, and large.
node_modules/
.pnp/
.pnp.js

# Build output from the application built during Phases 4-7.
dist/
dist-ssr/
*.local

# Env files carry secrets (CR-8.5: one secrets mechanism, never committed).
# .env.example IS committed — it documents required keys without their values.
.env
.env.*
!.env.example

# Editor / OS noise.
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.njsproj
*.sln
*.sw?

# Test and coverage artifacts — regenerated, and noisy in diffs.
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# Claude Code local state. .claude/skills/ IS committed on purpose — the
# vendored coding-rules ruleset is part of the course, not local config.
.claude/settings.local.json

# The mechanical ledger is a desk artifact and stays local. It records what ran
# on THIS PC — absolute Windows paths, the username inside every one of them,
# verbatim session quotes. Nothing secret; all of it personal, and the repo is
# public. The phone and tablet surfaces have no use for it.
#
# CONSEQUENCE, recorded so it is not rediscovered: a Claude Code cloud session
# clones from GitHub, so it will not have this file and cannot append to it.
# The ledger advances at the desk only; phone work lands in git and gets its
# entry on the next PC session. learning-records/ and NOTES.md carry the
# decisions and the why, and those DO travel.
#
# NOTE: this only stops FUTURE changes from publishing. history.txt is already
# present in commits f08d461..59c06d6 and stays readable at those SHAs.
history.txt
